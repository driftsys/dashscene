/target
**/*.rs.bk

# mdBook build output (docs/book is the source; mdBook's default
# build-dir is "book", relative to the root book.toml lives in)
/book

# Deno
importers/figma/.deno

# `just reprobe` scratch output — a live-only Figma import probe, never
# committed; the recipe removes it on exit, this is a backstop.
importers/figma/.reprobe-tmp.*

# `just render` scratch output — same live-only Figma import, never committed;
# the recipe removes it on exit, this is a backstop.
importers/figma/.render-tmp.*

# OS/editor cruft
.DS_Store
*.swp

# Python bytecode. Six scripts are tracked — the harness's `assert-drew.py` and
# `assert-drew-test.py`, `demo-web/serve.py` and three in a technote's assets.
# Running one as a script writes nothing, because CPython does not cache
# `__main__`; **importing or byte-compiling one does**, which is how PR #1098
# committed a `.pyc` while syntax-checking `assert-drew.py` with
# `python3 -m py_compile`.
#
# `assert-drew-test.py` is the first tracked script here that imports another —
# it loads `assert-drew.py` to compare decoded buffers — so it sets
# `sys.dont_write_bytecode` before doing so rather than relying on this line.
__pycache__/

# Claude Code worktrees (see markspec's deno.json precedent, docs/decisions/house-style.md)
.claude/worktrees/

# Golden-harness failure artifacts (goldens/README.md)
goldens/images/*.actual.png
# Layer-1 instance-buffer golden failure artifacts
# (docs/decisions/instance-buffer-contract.md)
crates/dashscene-gpu/tests/goldens/*.actual.txt

# .NET build output for `unity/abi-check` (story #1239). The check compiles the
# UPM package's own `BoundaryB.cs`; only sources are tracked.
unity/abi-check/bin/
unity/abi-check/obj/
# And for `unity/package-compat` (story #1125), the netstandard2.1 compile
# gate, for the same reason.
unity/package-compat/bin/
unity/package-compat/obj/
