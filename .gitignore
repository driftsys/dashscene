/target
**/*.rs.bk

# mdBook build output (docs/book is the source; mdBook's default
# build-dir is "book", relative to the root book.toml lives in)
/book

# Deno
importers/figma/.deno

# `just reprobe` scratch output — a live-only Figma import probe, never
# committed; the recipe removes it on exit, this is a backstop.
importers/figma/.reprobe-tmp.*

# `just render` scratch output — same live-only Figma import, never committed;
# the recipe removes it on exit, this is a backstop.
importers/figma/.render-tmp.*

# OS/editor cruft
.DS_Store
*.swp

# Claude Code worktrees (see markspec's deno.json precedent, docs/decisions/house-style.md)
.claude/worktrees/

# Golden-harness failure artifacts (goldens/README.md)
goldens/images/*.actual.png
# Layer-1 instance-buffer golden failure artifacts
# (docs/decisions/instance-buffer-contract.md)
crates/dashscene-gpu/tests/goldens/*.actual.txt
