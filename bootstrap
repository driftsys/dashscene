#!/usr/bin/env bash
# bootstrap — set up a fresh clone or worktree of dashscene-staging.
#
# Ensures git-std is installed, then hands off to it: `git std bootstrap`
# does the repo-specific setup (git hooks, etc.) from there. Run this
# right after cloning or creating a worktree.
#
# House style: docs/decisions/house-style.md. Adapted from driftsys/git-std's own
# bootstrap script.

set -euo pipefail

GIT_STD_VERSION="${GIT_STD_VERSION:-latest}"
INSTALL_DIR="${GIT_STD_INSTALL_DIR:-$HOME/.local/bin}"
# Pinned rather than `latest`: this is the only download here whose checksum
# file covers a whole release, so the version has to be known to name the file
# at all. A pin also means the bytes a fresh clone installs do not change under
# it without a commit that says so.
JQ_VERSION="${JQ_VERSION:-1.8.2}"

log() { printf '[bootstrap] %s\n' "$*" >&2; }
die() {
  printf '[bootstrap] error: %s\n' "$*" >&2
  exit 1
}

detect_platform() {
  local os arch
  case "$(uname -s)" in
    # git-std publishes musl builds for Linux (static, distro-independent);
    # there is no *-unknown-linux-gnu release asset.
    Linux) os="unknown-linux-musl" ;;
    Darwin) os="apple-darwin" ;;
    *) die "unsupported OS: $(uname -s)" ;;
  esac
  case "$(uname -m)" in
    x86_64 | amd64) arch="x86_64" ;;
    arm64 | aarch64) arch="aarch64" ;;
    *) die "unsupported architecture: $(uname -m)" ;;
  esac
  printf '%s-%s\n' "$arch" "$os"
}

install_git_std() {
  if command -v git-std >/dev/null 2>&1; then
    log "git-std already installed: $(command -v git-std)"
    return
  fi

  local target archive url tmp sha_expected sha_actual
  target="$(detect_platform)"
  archive="git-std-${target}.tar.gz"
  url="https://github.com/driftsys/git-std/releases/${GIT_STD_VERSION}/download/${archive}"

  log "downloading git-std (${GIT_STD_VERSION}, ${target})"
  tmp="$(mktemp -d)"
  trap 'rm -rf "${tmp}"' RETURN

  curl --fail --silent --show-error --location "${url}" --output "${tmp}/${archive}"
  curl --fail --silent --show-error --location "${url}.sha256" --output "${tmp}/${archive}.sha256"

  sha_expected="$(cut -d' ' -f1 "${tmp}/${archive}.sha256")"
  sha_actual="$(sha256sum "${tmp}/${archive}" | cut -d' ' -f1)"
  [ "${sha_expected}" = "${sha_actual}" ] || die "sha256 mismatch for ${archive}"

  mkdir -p "${INSTALL_DIR}"
  tar -xzf "${tmp}/${archive}" -C "${tmp}"
  install -m 0755 "${tmp}/git-std" "${INSTALL_DIR}/git-std"

  log "installed git-std to ${INSTALL_DIR}/git-std"
  case ":${PATH}:" in
    *":${INSTALL_DIR}:"*) ;;
    *) log "note: ${INSTALL_DIR} is not on PATH — add it to your shell profile" ;;
  esac
}

# cargo-nextest runs the test tiers (docs/decisions/test-tiers.md). Installed
# from the project's own prebuilt binary rather than `cargo install
# cargo-nextest`, which compiles it from source and would add minutes to every
# fresh clone and every worktree.
install_nextest() {
  # The convco CI job runs this script only to obtain git-std, and a
  # commit-message lint should not depend on a test runner's download host
  # being reachable.
  if [ -n "${BOOTSTRAP_SKIP_NEXTEST:-}" ]; then
    log "cargo-nextest install skipped (BOOTSTRAP_SKIP_NEXTEST is set)"
    return
  fi

  if command -v cargo-nextest >/dev/null 2>&1; then
    log "cargo-nextest already installed: $(command -v cargo-nextest)"
    return
  fi

  local platform cargo_bin url asset tmp sha_expected sha_actual
  case "$(uname -s)" in
    # These aliases are gnu-linked on Linux, where detect_platform() picks musl
    # for git-std. The difference is deliberate rather than an oversight:
    # nextest publishes no musl asset under these aliases, and every machine
    # this repository targets is either Darwin or the gnu-linked ubuntu CI
    # runner. A musl-only host would have to build nextest from source.
    Linux)
      case "$(uname -m)" in
        x86_64 | amd64) platform="linux" ;;
        arm64 | aarch64) platform="linux-arm" ;;
        *) die "unsupported architecture for cargo-nextest: $(uname -m)" ;;
      esac
      ;;
    # The mac tarball is a universal binary, so it needs no architecture case.
    Darwin) platform="mac" ;;
    *) die "unsupported OS for cargo-nextest: $(uname -s)" ;;
  esac

  url="https://get.nexte.st/latest/${platform}"
  cargo_bin="${CARGO_HOME:-$HOME/.cargo}/bin"
  tmp="$(mktemp -d)"
  trap 'rm -rf "${tmp}"' RETURN

  # get.nexte.st is a redirector, and the checksum is a separate release asset
  # beside the tarball: the same name with .tar.gz replaced by .sha256. Two
  # addresses cannot produce it. The redirector's own address has no checksum
  # beside it, and the fully resolved address is a pre-signed content-delivery
  # URL where a suffix means nothing — asking for that one plus ".sha256"
  # returns the tarball again, so the comparison below would fail on every
  # fresh install rather than only on a corrupted one. The address that works
  # is the first redirect target, taken without following it: that is the
  # release asset itself, and swapping its extension gives the checksum.
  asset="$(curl --fail --silent --show-error --output /dev/null \
    --write-out '%{redirect_url}' "${url}")"
  [ -n "${asset}" ] || die "get.nexte.st did not redirect for ${platform}"

  log "downloading cargo-nextest (${platform})"
  curl --fail --silent --show-error --location "${asset}" \
    --output "${tmp}/nextest.tar.gz"
  curl --fail --silent --show-error --location "${asset%.tar.gz}.sha256" \
    --output "${tmp}/nextest.tar.gz.sha256"
  sha_expected="$(cut -d' ' -f1 "${tmp}/nextest.tar.gz.sha256")"
  # macOS ships shasum, not sha256sum. install_git_std above calls sha256sum
  # unconditionally, which means its own download path cannot work on a Mac —
  # noted here, not fixed here, because it is outside this change.
  if command -v sha256sum >/dev/null 2>&1; then
    sha_actual="$(sha256sum "${tmp}/nextest.tar.gz" | cut -d' ' -f1)"
  else
    sha_actual="$(shasum -a 256 "${tmp}/nextest.tar.gz" | cut -d' ' -f1)"
  fi
  [ "${sha_expected}" = "${sha_actual}" ] || die "sha256 mismatch for cargo-nextest"

  # Extract in the temporary directory and move the finished binary into place,
  # the way install_git_std does. Streaming the download straight into
  # ${cargo_bin} would leave a truncated cargo-nextest there if the transfer
  # failed partway, and the "already installed" check at the top of this
  # function would then skip the repair on every later run — a broken install
  # that reports itself as done.
  tar -xzf "${tmp}/nextest.tar.gz" -C "${tmp}"
  mkdir -p "${cargo_bin}"
  install -m 0755 "${tmp}/cargo-nextest" "${cargo_bin}/cargo-nextest"

  log "installed cargo-nextest to ${cargo_bin}/cargo-nextest"
  case ":${PATH}:" in
    *":${cargo_bin}:"*) ;;
    *) log "note: ${cargo_bin} is not on PATH — add it to your shell profile" ;;
  esac
}

# jq parses the tier listings. `just calibrate` and `just exit-gate` both read
# `cargo nextest list --message-format json` through it, because nextest's
# default listing is a rendering with no stability promise and changed under
# those checks once already (docs/decisions/test-tiers.md). Without jq neither
# recipe runs, which is the same reason cargo-nextest is installed here.
#
# Unlike git-std and cargo-nextest, jq is an ordinary system utility and most
# machines already have one. The guard below is what makes this cheap: a
# download only happens on a machine that has none.
install_jq() {
  if command -v jq >/dev/null 2>&1; then
    log "jq already installed: $(command -v jq)"
    return
  fi

  local os arch asset url tmp sha_expected sha_actual bin_dir
  case "$(uname -s)" in
    Darwin) os="macos" ;;
    Linux) os="linux" ;;
    *) die "unsupported OS for jq: $(uname -s)" ;;
  esac
  case "$(uname -m)" in
    arm64 | aarch64) arch="arm64" ;;
    x86_64 | amd64) arch="amd64" ;;
    *) die "unsupported architecture for jq: $(uname -m)" ;;
  esac
  asset="jq-${os}-${arch}"
  url="https://github.com/jqlang/jq/releases/download/jq-${JQ_VERSION}/${asset}"

  log "downloading jq (${JQ_VERSION}, ${os}-${arch})"
  tmp="$(mktemp -d)"
  trap 'rm -rf "${tmp}"' RETURN

  curl --fail --silent --show-error --location "${url}" --output "${tmp}/jq"
  # jq publishes one sha256sum.txt covering every asset in the release, rather
  # than a .sha256 beside each one, so the line for this asset is selected
  # here. Anchored on the trailing name so `jq-linux-amd64` cannot match
  # `jq-linux-amd64-something` if the release ever adds one.
  curl --fail --silent --show-error --location \
    "https://github.com/jqlang/jq/releases/download/jq-${JQ_VERSION}/sha256sum.txt" \
    --output "${tmp}/sha256sum.txt"
  sha_expected="$(awk -v a="${asset}" '$2 == a || $2 == "*" a { print $1 }' "${tmp}/sha256sum.txt")"
  [ -n "${sha_expected}" ] || die "sha256sum.txt has no line for ${asset}"
  if command -v sha256sum >/dev/null 2>&1; then
    sha_actual="$(sha256sum "${tmp}/jq" | cut -d' ' -f1)"
  else
    sha_actual="$(shasum -a 256 "${tmp}/jq" | cut -d' ' -f1)"
  fi
  [ "${sha_expected}" = "${sha_actual}" ] || die "sha256 mismatch for ${asset}"

  bin_dir="${INSTALL_DIR}"
  mkdir -p "${bin_dir}"
  install -m 0755 "${tmp}/jq" "${bin_dir}/jq"

  log "installed jq to ${bin_dir}/jq"
  case ":${PATH}:" in
    *":${bin_dir}:"*) ;;
    *) log "note: ${bin_dir} is not on PATH — add it to your shell profile" ;;
  esac
}

# gitleaks backs `just secrets`, which `just check` runs. It is not installed
# here: it publishes no single-file binary this script can verify by checksum
# the way git-std, nextest and jq are, and a secret scanner fetched over an
# unverified path is the wrong thing to add to a bootstrap. Report its absence
# instead, with the one-line install, so a fresh clone learns about it here
# rather than from a failing `just check`.
check_gitleaks() {
  if command -v gitleaks >/dev/null 2>&1; then
    log "gitleaks present: $(command -v gitleaks)"
    return
  fi
  log "note: gitleaks is not installed — 'just secrets' and 'just check' need it"
  case "$(uname -s)" in
    Darwin) log "      install with: brew install gitleaks" ;;
    *)      log "      install from: https://github.com/gitleaks/gitleaks/releases" ;;
  esac
}

install_git_std
install_nextest
install_jq
check_gitleaks
exec git std bootstrap
