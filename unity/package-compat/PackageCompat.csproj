<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The point of this project. Unity's default API compatibility level is
         .NET Standard 2.1, and `unity/abi-check` targets net10.0, which is a
         strict superset — so it accepts declarations Unity would refuse and
         cannot stand in for this check.

         Measured rather than reasoned: adding
         `public static System.Half H() => (System.Half)1.0f;` to
         `Runtime/BoundaryB.cs` builds clean under net10.0 and fails here with
         CS0234. That is the drift this project exists to catch, and it is why
         `07-embedding-and-distribution.md` R-E10 names this project and not
         the other one. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- Compile only what is listed below, so this project reports on the
         package's sources and not on stray files beside it. This does NOT stop
         an empty set from passing — `RefuseAnEmptyCompileSet` below does, and
         it was added because the first version of this file claimed this
         property closed that hazard and it does not. -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The asmdef sets `allowUnsafeCode: true` (R-E13, forced by
         `BatchCullingOutputDrawCommands`'s raw pointer fields), so Unity will
         compile `Runtime/` with unsafe blocks enabled and this project must
         too. Without it the first `unsafe` member story #1122 adds compiles in
         Unity and fails here with CS0227 — this project holding the package to
         a stricter contract than the one it ships into, which is exactly what
         it must not do. Measured: a trivial `unsafe` member reproduces CS0227
         with this line removed. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Same reason `AbiCheck.csproj` sets it: this project exists to detect
         drift, and a declaration the compiler is unsure about is drift. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>package-compat</AssemblyName>
    <RootNamespace>Driftsys.Dashscene.PackageCompat</RootNamespace>
  </PropertyGroup>

  <!-- The demonstration configuration (story #1342), off unless asked for.

       `Runtime/DemoProducer.cs` is behind `DASHSCENE_DEMO_PRODUCER`, so the
       default pass compiles an empty file. `unity/ffi-check` compiles its real
       body, but at net10.0 — a superset of what Unity accepts, which that
       project's own comment says is why it cannot stand in for this one. So
       without this pass the only thing that ever compiled that file the way
       Unity will was `just unity-demo`'s player build: editor-only, outside CI,
       tens of minutes. A netstandard2.1-unavailable API added there would have
       been caught by nothing until then. Found by the review of PR #1365. -->
  <PropertyGroup Condition="'$(DemoProducer)' == 'true'">
    <DefineConstants>$(DefineConstants);DASHSCENE_DEMO_PRODUCER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- Every runtime source in the package, by glob rather than by name, so a
         file story #1121 or #1122 adds is covered without editing this list.
         `abi-check` names `BoundaryB.cs` alone because it compares that one
         file's types; this project asks a question about the whole package.

         Collected under its own item name first, because `@(Compile)` is never
         empty — the SDK injects a generated AssemblyInfo into it — so testing
         that would not detect a glob that reached nothing. -->
    <PackageRuntimeSource Include="../com.driftsys.dashscene/Runtime/**/*.cs"
                          Exclude="../com.driftsys.dashscene/Runtime/Engine/**/*.cs" />
    <Compile Include="@(PackageRuntimeSource)" />

    <!-- What the exclusion above leaves out, so the target below can report on
         it rather than leaving it invisible. -->
    <PackageEngineSource Include="../com.driftsys.dashscene/Runtime/Engine/**/*.cs" />
  </ItemGroup>

  <!-- A gate that compiles nothing passes, and reports nothing. Measured: with
       the glob pointed at a directory that does not exist, the build succeeds
       with zero errors, so `07-embedding-and-distribution.md` R-E10 would read
       as met over an empty set. This is the same non-empty rule R-E11 states
       for the painter's shaders, applied to this project. -->
  <Target Name="RefuseAnEmptyCompileSet" BeforeTargets="BeforeBuild">
    <Error Condition="'@(PackageRuntimeSource)' == ''"
           Text="package-compat matched no source file. The glob reached nothing — has unity/com.driftsys.dashscene/Runtime/ moved? A gate over an empty set reports on nothing." />
  </Target>

  <!-- What this project does NOT compile, said out loud on every run.

       `Runtime/Engine/` holds the BatchRendererGroup painter, and every file
       in it references `UnityEngine`. This project has no Unity reference
       assemblies, so those types fail to resolve here whatever their API
       compatibility level actually is — which is issue #1286, and
       `docs/decisions/r-e10-is-checked-in-two-halves.md` is the ruling. R-E10
       is met over that half by a Unity editor instead: `just unity-editor`.

       Printed rather than silent because the cheap repair to the failure this
       exclusion answers is to widen it, and a narrowing nobody sees is how
       R-E10 would end up covering three files and reading as met. -->
  <Target Name="ReportWhatIsNotCompiled" BeforeTargets="BeforeBuild">
    <Message Importance="high"
             Condition="'@(PackageEngineSource)' != ''"
             Text="package-compat: not compiled here (engine-referencing, checked by `just unity-editor`): @(PackageEngineSource->'%(Filename)%(Extension)', ', ')" />
  </Target>

</Project>
