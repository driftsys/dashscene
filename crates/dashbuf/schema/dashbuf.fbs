// The .dsb document schema (DESIGN_1.md §5, §11 v0.1).
//
// v0.1 walking-skeleton scope only: a flattened node tree (doc index =
// rect-table index, DESIGN §5), one layout mode (fixed-size, no Taffy
// yet), one paint kind (solid fill). Additional layout modes and paint
// kinds land as unions/enums when v0.2/v0.3 actually add them —
// FlatBuffers' append-only field ids make that an additive change, not
// a rewrite (R7).

namespace dashbuf;

struct FixedSizeLayout {
  width: float32;
  height: float32;
}

struct Color {
  r: float32;
  g: float32;
  b: float32;
  a: float32;
}

table SolidFill {
  color: Color;
}

table Node {
  name: string;
  // Index into Document.nodes of this node's parent, or NO_PARENT
  // (uint32::MAX) for a root node.
  parent: uint32 = 4294967295;
  layout: FixedSizeLayout;
  paint: SolidFill;
}

table Document {
  // Flattened DFS node tree: array order is DFS order, so array index
  // doubles as rect-table index (DESIGN §5).
  nodes: [Node];
}

root_type Document;
