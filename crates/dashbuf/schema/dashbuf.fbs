// The .dsb document schema (docs/design/dashbuf.md, docs/roadmap.md
// v0.1 + v0.2 flex + v0.3 paint).
//
// Scope: a flattened node tree (doc index = rect-table index,
// docs/design/dashbuf.md); the v0.2 flex layout vocabulary (mode NONE/H/V, hug/fill/fixed
// sizing per axis, gap, padding, alignment, min/max — wrap and grid
// land at v0.8 as appended enum values); and the v0.3 paint vocabulary
// (docs/roadmap.md v0.3, drawn from the docs/specification/04-figma-vocabulary-profile.md
// NOW list): solid fills, the
// four gradient kinds, image fills with scale modes, stroke with
// align, rounded corners, axis-aligned + rounded clip. Paint sits in a
// document-level dedup pool (docs/design/dashbuf.md) that nodes reference by index
// — the same index model as the runtime paint table. FlatBuffers'
// append-only field ids make every extension additive, not a rewrite
// (R7).
//
// R7 is guarded by bytes, not by convention: append new fields at the
// tail of a table, and append new enum and union members at the tail
// with the existing members untouched. Any edit that shifts a field id
// or a union discriminant breaks every .dsb already written to disk,
// and `tests/fixtures/v0_5_document.dsb` — a frozen document that
// `tests/schema_evolution.rs` decodes with the current bindings — is
// what turns that into a failing test. Regenerate that fixture only on
// a deliberate, reviewed format-generation bump, never to make the
// suite go green (docs/decisions/dsb-frozen-fixture-r7-guard.md).

namespace dashbuf;

struct FixedSizeLayout {
  // Authored offset relative to the parent node (or the canvas origin
  // for a root). Intent, not a resolved result (P1) — the resolved
  // absolute position exists only in the runtime rect table.
  x: float32;
  y: float32;
  width: float32;
  height: float32;
}

struct Color {
  r: float32;
  g: float32;
  b: float32;
  a: float32;
}

table SolidFill {
  color: Color;
}

struct Vec2 {
  x: float32;
  y: float32;
}

// A row-major 2x3 affine transform: maps (x, y) to
// (a*x + b*y + tx, c*x + d*y + ty).
struct Mat23 {
  a: float32;
  b: float32;
  c: float32;
  d: float32;
  tx: float32;
  ty: float32;
}

// One gradient color stop; offset is normalized 0..1 along the
// gradient's primary axis.
struct GradientStop {
  offset: float32;
  color: Color;
}

// Per-corner radii in document units; all zero = sharp corners.
struct CornerRadii {
  top_left: float32;
  top_right: float32;
  bottom_right: float32;
  bottom_left: float32;
}

enum GradientKind : uint8 {
  Linear = 0,
  Radial,
  Angular,
  Diamond,
}

// Stroke placement relative to the node's outline. Painters that only
// stroke on center lower Inside/Outside by path expansion
// (docs/technotes/rendering-and-painters.md).
enum StrokeAlign : uint8 {
  Inside = 0,
  Center,
  Outside,
}

// Figma image-fill scale modes.
enum ScaleMode : uint8 {
  Fill = 0,
  Fit,
  Crop,
  Tile,
}

// Append-only (P4): a new container format is a new variant at the end, never
// a reordering. Jpeg and Gif (story #342) are Figma's other two Fill-time
// containers — Figma re-encodes opaque uploads to Jpeg, and Gif covers
// static (single-frame) image fills; animated Gif is refused upstream at
// the importer (`figma-image-animated-gif`), so it never reaches this enum.
enum ImageFormat : uint8 {
  Png = 0,
  Jpeg = 1,
  Gif = 2,
}

// One geometry model serves all four gradient kinds: three normalized
// handle positions in the node's box — the gradient origin, the
// primary-axis end, and the secondary-axis end (Figma's
// gradientHandlePositions). Handles are intent; resolved geometry is
// per-painter math (P1). Handles and stops are required so the
// flatbuffer verifier itself rejects a geometry-less gradient at the
// load gate (P4) instead of a painter inventing defaults.
table Gradient {
  kind: GradientKind;
  handle_origin: Vec2 (required);
  handle_primary: Vec2 (required);
  handle_secondary: Vec2 (required);
  stops: [GradientStop] (required);
}

table ImageFill {
  // Index into Document.assets — the asset whose payload this fill draws.
  // Named `image` since v0.3; the pool it indexes moved to the content-addressed
  // asset table at v0.11 (story #107), the field id did not.
  image: uint32;
  scale_mode: ScaleMode;
  // Normalized image-space transform for ScaleMode::Crop (Figma's
  // imageTransform); identity when absent.
  transform: Mat23;
  // Tile magnification for ScaleMode::Tile (Figma's scalingFactor).
  tile_scale: float32 = 1.0;
}

union Fill {
  SolidFill,
  Gradient,
  ImageFill,
}

// One stacked fill layer (story C1, debt #146): a `Fill` union wrapped in a
// table, so it can sit in a vector — flatc does not support a vector of a
// bare union for Rust. Carries nothing beyond the fill itself: a layer's
// opacity is already folded into its own color/stops the same way a lone
// `Paint.fill` is, and a non-plain blend mode is refused upstream by name
// (the profile triage), so no other field belongs here.
table FillLayer {
  fill: Fill;
}

// v0.3 strokes are solid-only (see
// docs/decisions/paint-entry-composition.md); the color widens to a
// fill additively if a real file ever needs gradient strokes (R6
// diagnoses them until then). The color is required: a stroke without
// one has no meaning, and requiring it keeps the shape identical to
// dashpaint's mirror (where the color is not optional).
table Stroke {
  width: float32;
  align: StrokeAlign;
  color: Color (required);
}

// Embedded encoded image bytes — the v0.3 storage form, retired at v0.11
// (story #107). Kept only because `Document.images` is deprecated rather than
// deleted and a deprecated field still needs its type to exist. Nothing writes
// or reads one.
table Image {
  format: ImageFormat;
  bytes: [ubyte];
}

// One asset's identity and the metadata a runtime needs before its payload
// exists (docs/decisions/asset-model-content-addressed-blobs.md, story #107).
// The bytes live outside this buffer, in a blob section of the file's envelope
// (docs/design/dsb-container-format.md) — P1 applied to assets: the document
// carries intent, never results.
//
// `hash` is the canonical payload's identity: BLAKE3-256 over the well-known
// format's own bytes, with no dashscene framing. It is resolved to bytes
// through a *binding*. v0.11 ships one profile, RAW, whose binding is the
// identity map — find the blob section whose content hash equals this one — so
// the resident payload is the canonical payload and the two readings coincide.
// A later profile binds the same canonical hash to a derived payload through a
// derivation manifest, and only the binding changes.
//
// Because the entry names a hash and never a section index, this table does not
// depend on where a payload sits in the file. That is what makes the intended
// "hot sections byte-identical across assemblies of one document" invariant
// reachable; v0.11 ships one assembly, so it is intent, not a tested claim.
//
// `width`/`height` are the intrinsic pixel extent, read from the payload's own
// header by dashc's image gate (docs/decisions/dashc-identifies-images-never-decodes.md).
// They are here so layout and first paint never block on a payload, and the
// load gate cross-checks them against the payload the entry names — the hot
// entry and the blob are two places describing one asset, and that rule is what
// keeps them from drifting apart.
//
// What an asset's payload *is*, as opposed to how it is encoded. This is the
// key the packer's hard rules read before any measurement: a distance field
// never enters a lossy path, so the choice of encoding is settled by the kind
// and never by a band (v0.12, story #432,
// docs/decisions/asset-quality-profile-bands.md).
//
// `Image` is value 0 on purpose. Every entry written before this field existed
// is an image, so the default reading is the correct one, and a writer that does
// not set the field writes nothing — which is why appending it moved no
// committed `.dsb` byte.
enum AssetKind : uint8 {
  // Displayed picture data: an image fill's PNG/JPEG/GIF payload. Lossy block
  // encoding is admissible, subject to the profile's measured band.
  Image = 0,
  // A signed or multi-channel distance field — a baked vector's MSDF, a glyph
  // atlas. Never lossy, whatever the profile
  // (docs/decisions/baked-vector-msdf-field.md).
  DistanceField = 1,
}

// Two fields the asset-model record names are deliberately absent until they
// have a producer and a consumer: a placeholder colour (computing one needs
// pixel access dashc cannot have, and its consumer — placeholder activation
// while a payload is not resident — is v1), and a flavor/locator bit (every
// payload here is resident-raw, and the section table already says where). Both
// are appends, which is the R7-cheap change — the same change `kind` was.
table AssetEntry {
  hash: [ubyte] (required);
  format: ImageFormat;
  // width and height are the container's own reported extent — the PNG IHDR,
  // the JPEG SOF frame header, or the GIF logical screen descriptor
  // (dashpaint::image_id::identify) — never a decoder-reported extent. For
  // GIF that is the logical screen, not a frame's own, smaller image
  // descriptor; for JPEG it is the stored SOF dimensions, with no EXIF
  // Orientation transform applied even where Orientation is 5-8, which
  // transposes what a decoder displays. Every writer today derives both
  // fields through the same header parse a decoding writer might not use, so
  // pin this before one does (debt #449).
  width: uint32;
  height: uint32;
  // Appended at v0.12. Defaults to `Image`, so `flatc` omits it for every
  // entry dashc writes today and the committed goldens are unmoved.
  kind: AssetKind;
}

// One row of the derivation manifest (v0.12, story #434,
// docs/decisions/derivation-manifest-section.md): the canonical identity an
// `AssetEntry` names, and the content hash of the payload this file actually
// carries for it.
//
// Both sides are hashes. Neither is a section index, which is what keeps the
// property docs/decisions/asset-model-content-addressed-blobs.md rests on: a
// document never learns where a payload sits, so its hot sections do not vary
// with the profile that packed the file.
table AssetBinding {
  // The `AssetEntry.hash` this row speaks for — the canonical payload's
  // BLAKE3, which is the asset's identity and never changes with the profile.
  canonical: [ubyte] (required);
  // The BLAKE3 of the bytes the file carries for it, which is the blob
  // section's own recorded content hash.
  resident: [ubyte] (required);
}

// The derivation manifest: the profile's binding from canonical identities to
// the payloads this file resides them as.
//
// Its own root type, carried in its own section rather than in `Document`
// above. That is the whole point: a manifest inside the document would make
// the hot section vary with the profile, and it would put a packer *result*
// into a document that carries only intent (P1).
//
// Rows are written only where the binding is not the identity — RAW derives
// nothing, so a RAW file carries no manifest section at all and no committed
// `.dsb` byte moved when this landed.
table AssetBindings {
  bindings: [AssetBinding];
}

// A drop or inner shadow effect (v0.8, story #45,
// docs/decisions/effects-vocabulary-shadows.md). Authored intent only —
// offset, blur radius, spread, and color, per the shadow-spread math of
// docs/archive/2026-07-14-design-1-seed.md §8.1. The resolved shadow
// geometry (the spread-expanded, offset, blurred shape) is a painter
// result, never in the document (P1). Effects enter the schema here; the
// NOW band is drop and inner shadows only — noise, texture, and
// progressive blur stay REJECT (docs/specification/04-figma-vocabulary-profile.md).
// Backdrop blur joined the NOW band at v0.11
// (docs/decisions/backdrop-blur-is-core-vocabulary.md); layer blur stays
// budgeted at v1 and needs no schema change when it lands, because `Blur`
// below already carries the kind that distinguishes the two.
enum ShadowKind : uint8 {
  Drop = 0,
  Inner = 1,
}

// One shadow. `blur` is the Gaussian blur radius in document units
// (non-negative); `spread` grows the shadow shape (a drop shadow outward,
// an inner shadow's lit hole inward) and may be negative. `color` is
// required: a shadow with no color has no meaning, and the verifier
// rejects it at the load gate (P4) — the same mechanism as Stroke's
// required color.
table Shadow {
  kind: ShadowKind;
  offset: Vec2;
  blur: float32;
  spread: float32;
  color: Color (required);
}

// A blur effect (v0.11, story #393,
// docs/decisions/backdrop-blur-is-core-vocabulary.md).
//
// `Layer` blurs the node's own composited content; `Backdrop` blurs what is
// already composited beneath the node, seen through the node's own
// transparency. Only `Backdrop` is emitted today — layer blur is budgeted at
// v1 — but the kind is in the schema from the start so that adding it later
// is a lowering change and not a second schema break, which is the one
// constraint the decision record places on this representation.
//
// The distinction matters far past naming: a layer blur is node-local, like
// every effect before it, while a backdrop blur is the first effect that
// requires a painter to read the already-composited backdrop. That
// consequence is a boundary-B concern and is declared there, not here — the
// document carries the authored intent, and what a painter must do about it
// is the painter's contract (P1).
enum BlurKind : uint8 {
  Layer = 0,
  Backdrop = 1,
}

// One blur. `radius` is the Gaussian blur radius in document units,
// non-negative, and carries Figma's `radius` verbatim — the painter's sigma
// mapping (sigma = 0.4375 * radius, Figma's measured constant) is a painter
// concern, exactly as it is for `Shadow.blur`
// (docs/decisions/blur-sigma-is-figmas-mapping.md).
table Blur {
  kind: BlurKind;
  radius: float32;
}

// One entry of the document's paint pool (docs/design/dashbuf.md's "dedup style
// pool"): what a node is filled with, how its outline is stroked, how
// its corners round, and whether it clips its children to the (rounded)
// box. Nodes reference entries by index; distinct nodes sharing a style
// share one entry.
table Paint {
  fill: Fill;
  stroke: Stroke;
  corners: CornerRadii;
  clip: bool = false;
  // v0.8 shadows (story #45). A node's drop and inner shadows in paint
  // order; absent (the pre-v0.8 default) means no shadows, so old
  // documents emit unchanged (R7). Effects dedup with the rest of the
  // entry — two nodes sharing a style and shadows share one pool entry.
  shadows: [Shadow];
  // Story B1 — the shape channel. NO_FIELD (uint32::MAX, the same
  // sentinel-index convention as Node.paint_entry/text) is the implicit
  // parametric shape, the rounded box `corners` already describes. A valid
  // index selects a baked MSDF coverage mask,
  // Document.vector_shapes[shape_field], which the painter samples and masks
  // the fill by. Appended at the tail with the sentinel default, so a pre-B1
  // paint entry emits byte-identically (R7).
  shape_field: uint32 = 4294967295;
  // Story C1 (debt #146) — stacked fills. `fill` is the bottom (first
  // visible) fill, unchanged in meaning; `extra_fills`, when present, are
  // the fills stacked over it, painted in array order (bottom to top — the
  // same back-to-front convention as `shadows`/Figma's `effects` and
  // `children`). Absent (the pre-C1 default) means a single fill, so every
  // pre-C1 paint entry emits byte-identically (R7).
  extra_fills: [FillLayer];
  // v0.11 blur effects (story #393). A node's blurs, absent (the pre-v0.11
  // default) meaning none, so every earlier paint entry emits
  // byte-identically and no committed `.dsb` fixture changes (R7). Blurs
  // dedup with the rest of the entry, exactly as `shadows` do.
  blurs: [Blur];
}

// Horizontal text alignment within the node box (Figma's
// textAlignHorizontal, story #310). Left is the default: the runtime flushes
// an LTR paragraph left and an RTL one right by direction. Append new members
// at the tail (JUSTIFIED has no lowering yet); a reader that meets an unknown
// value range-checks and refuses it by name (P4), like the layout enums.
enum TextAlign : uint8 {
  Left = 0,
  Center = 1,
  Right = 2,
}

// Vertical alignment of the text block within the node box (Figma's
// textAlignVertical, story #310). Top is the default the runtime places from.
enum TextAlignV : uint8 {
  Top = 0,
  Center = 1,
  Bottom = 2,
}

// One entry of the document's text style pool (docs/design/dashbuf.md's "dedup
// style pool" applied to text): how a text node renders. Never glyph
// data (P1) — family/size/weight/color/metrics are intent; shaping and
// placement happen in the runtime (docs/design/architecture.md).
table TextStyle {
  // Font family name. Required: a family-less style has no meaning,
  // and the verifier rejects it at the load gate (P4) — the same
  // mechanism as Gradient's required fields.
  family: string (required);
  // Em size in document units.
  size: float32;
  // CSS-scale weight, 100 to 900 inclusive.
  weight: ushort = 400;
  color: Color;
  // v0.9 text vocabulary widening (story #310,
  // docs/decisions/figma-text-lowering.md). Appended at the tail with
  // behavior-preserving defaults so a style using none of them emits
  // byte-identically (R7): a pre-#310 document decodes with these absent.
  // A fixed line height in document units; absent (null) is auto — the
  // font's natural line advance (Figma's INTRINSIC_%). Only Figma's PIXELS
  // unit lowers here; a percentage line height stays a named diagnostic.
  line_height_px: float32 = null;
  // Letter spacing (tracking) in document units. Zero (the default) is no
  // tracking, so it is omitted from a plain style.
  letter_spacing: float32 = 0;
  // Horizontal alignment; Left (the default) is omitted.
  text_align: TextAlign = Left;
  // Vertical alignment within the box; Top (the default) is omitted.
  text_align_v: TextAlignV = Top;
  // Standard ligatures forced off (story #341,
  // docs/decisions/figma-text-lowering.md): Figma's OpenType `LIGA: 0` flag,
  // the one OpenType feature the vocabulary lowers — every other flag has no
  // vocabulary and stays a named diagnostic. `false` (the default) is
  // omitted, so a pre-#341 style emits byte-identically (R7).
  ligatures_off: bool = false;
}

// v0.2 flex layout vocabulary (docs/design/dashbuf.md, R2). New members append at
// the tail with explicit values: appending keeps old documents
// decoding unchanged, but a reader built before an append receives the
// unknown value as a raw integer — the load gate must range-check and
// emit a named diagnostic (P4/R6), never default silently. Wrap and
// Grid appended at v0.8 (story #43): Wrap is a horizontal wrapping row
// — Figma's layoutWrap exists for horizontal auto-layout only — and
// Grid places children in the LayoutContainer track lists below.
enum LayoutMode : uint8 {
  None = 0,
  Horizontal = 1,
  Vertical = 2,
  Wrap = 3,
  Grid = 4,
}

// How a node sizes itself along one axis. Fixed uses the
// FixedSizeLayout width/height as the datum; Hug wraps content; Fill
// stretches into the parent's free space.
enum AxisSizing : uint8 {
  Fixed = 0,
  Hug = 1,
  Fill = 2,
}

enum MainAxisAlign : uint8 {
  Start = 0,
  Center = 1,
  End = 2,
  SpaceBetween = 3,
}

// Baseline appended at v0.8 (story #43, Q-4): counter-axis baseline
// alignment for a horizontal row. The runtime's baselines are the flex
// baselines Taffy computes — a leaf's baseline is its bottom edge, a
// nested row propagates its first line's baseline.
enum CrossAxisAlign : uint8 {
  Start = 0,
  Center = 1,
  End = 2,
  Baseline = 3,
}

struct EdgeInsets {
  left: float32;
  top: float32;
  right: float32;
  bottom: float32;
}

// How one grid track sizes (v0.8, story #43). Fixed is a document-unit
// length; Fraction is a flexible weight over the free space — Figma's
// minmax(0, Nfr) serialized track. Append new members at the tail
// (P4/R6 range-check discipline, like the enums above).
enum GridTrackSizing : uint8 {
  Fixed = 0,
  Fraction = 1,
}

// One grid row or column track (v0.8, story #43). A table, not a
// struct, so a future bound (a minmax minimum, a named line) appends
// as a field instead of forcing a parallel vocabulary.
table GridTrack {
  sizing: GridTrackSizing;
  // Document units for Fixed; the flexible weight for Fraction.
  value: float32;
}

// Container-side layout properties — meaningful when mode != None.
// Under H/V the container places its children; the children's
// authored FixedSizeLayout x/y offsets are ignored (the solver owns
// placement, P1/P2) — an authored offset applies only under a
// mode=None parent. Absent padding means zero insets. Mode-neutral
// name: the v0.8 grid mode adds its track fields here rather than in
// a parallel table.
table LayoutContainer {
  mode: LayoutMode;
  gap: float32;
  padding: EdgeInsets;
  main_align: MainAxisAlign;
  cross_align: CrossAxisAlign;
  // v0.8 (story #43). The cross-axis gap: the spacing between wrap
  // lines (Figma's counterAxisSpacing) and between grid rows (Figma's
  // gridRowGap) — `gap` stays the main-axis spacing, which for Wrap
  // and Grid is the horizontal one (Figma's itemSpacing /
  // gridColumnGap). Absent = follows `gap`, preserving the v0.2
  // both-axes mapping for every existing document.
  cross_gap: float32 = null;
  // v0.8 (story #43). The grid track lists, meaningful when
  // mode = Grid: row tracks top-to-bottom, column tracks
  // left-to-right. Absent under mode = Grid means implicit auto
  // tracks.
  grid_rows: [GridTrack];
  grid_columns: [GridTrack];
}

// Child-side layout constraints, valid on any node. Absent min/max
// scalars mean unconstrained — absence of intent is not a value of
// intent (P1), so no sentinel values.
table LayoutConstraints {
  sizing_h: AxisSizing;
  sizing_v: AxisSizing;
  min_width: float32 = null;
  max_width: float32 = null;
  min_height: float32 = null;
  max_height: float32 = null;
  // Outer margin around the node in its parent's flow. Absent means
  // zero insets. Negative values are legal and express overlap — the
  // target the negative-gap Figma≠CSS lowering rewrites to (docs/design/dashbuf.md).
  margin: EdgeInsets;
  // v0.8 (story #43). Grid placement, meaningful under a mode = Grid
  // parent: the 0-based anchor cell (Figma's gridRowAnchorIndex /
  // gridColumnAnchorIndex) and the number of tracks spanned. Absent
  // anchors mean auto-placement in document order.
  grid_row: ushort = null;
  grid_column: ushort = null;
  grid_row_span: ushort = 1;
  grid_column_span: ushort = 1;
}

table Node {
  name: string;
  // Index into Document.nodes of this node's parent, or NO_PARENT
  // (uint32::MAX) for a root node.
  parent: uint32 = 4294967295;
  layout: FixedSizeLayout;
  // v0.1 walking-skeleton solid shorthand. Superseded by `paint_entry`
  // when that field is set; kept (append-only ids, R7) until the v0.1
  // producers stop writing it, then removed in a coordinated cleanup.
  paint: SolidFill;
  // Index into Document.paints, or NO_PAINT (uint32::MAX — the same
  // sentinel convention as `parent`) for a node that draws nothing.
  // Document-level only: the committed runtime output has no sentinel —
  // every rect resolves to a pool entry
  // (docs/decisions/boundary-b-unification.md).
  paint_entry: uint32 = 4294967295;
  // Index into Document.strings, or NO_TEXT (uint32::MAX — the same
  // sentinel convention as `parent`/`paint_entry`; the named constants
  // live in the crate root) for a node without text content.
  text: uint32 = 4294967295;
  // Index into Document.text_styles, or NO_TEXT_STYLE (uint32::MAX)
  // for unstyled text (a diagnostic once text validation exists;
  // never a silent default).
  text_style: uint32 = 4294967295;
  // v0.2 flex vocabulary. Absent tables mean: not a layout container
  // (mode None) / fully default constraints (Fixed sizing,
  // unconstrained min/max).
  flex: LayoutContainer;
  constraints: LayoutConstraints;
  // v0.8 masks + group opacity (story #44,
  // docs/decisions/masks-and-group-opacity.md). Node/group alpha in
  // [0, 1]; the default 1.0 omits the field from a fully-opaque node so
  // pre-v0.8 documents emit unchanged (R7). Resolved at commit into the
  // per-rect free alpha boundary B carries, or a render-target group for
  // an overlapping subtree (P1: the document carries intent, never the
  // resolved composite).
  opacity: float32 = 1.0;
  // Whether this node is a mask: it stencils the siblings that follow it
  // to its own (rounded) box and draws nothing itself. Resolved at commit
  // into those siblings' clip regions (issue #97's machinery reused).
  mask: bool = false;
  // Whether the node is drawn and takes part in layout (Figma's
  // `visible`). The default `true` omits the field; `false` lowers to
  // Taffy Display::None (Prop::Visible, issue #165) — the node keeps its
  // rect-table index but takes no space and draws nothing. A hidden node
  // is routine in real Figma files (debt #143).
  visible: bool = true;
  // The node's rotation, in radians, about `rotation_anchor`. Paint-only:
  // the solver never sees it and the node's own box is unchanged
  // (docs/decisions/rotation-is-paint-only-and-anchored-explicitly.md).
  // Zero — the default, which omits the field — is unrotated.
  //
  // Radians because that is this schema's unit for an angle and Figma's
  // wire unit. Figma's REST `rotation` is radians despite what
  // crates/dashc/src/figma/rest.rs once claimed; SVG's `rotate()` is
  // degrees and the SVG producer converts.
  rotation: float32 = 0.0;
  // The point the rotation turns about, in the node's own coordinate
  // space — (0, 0) is the node's top-left, which is the canonical value
  // and what Figma's `relativeTransform` does. SVG's `rotate(a cx cy)`
  // resolves into this frame as (cx - ex, cy - ey), and its bare
  // `rotate(a)` as (-ex, -ey), both being rotations about the user-space
  // origin rather than about a centre. A designer's "about the centre" is
  // (w/2, h/2), stated rather than defaulted.
  rotation_anchor_x: float32 = 0.0;
  rotation_anchor_y: float32 = 0.0;
}

// v0.4 variant table (docs/decisions/variant-set-flat-index.md,
// docs/archive/2026-07-14-design-1-seed.md §5: "sparse per-variant
// overrides, never duplicate trees"). One overridden prop's value,
// mirroring the slice of dashscene-core's `Prop` vocabulary needed to
// prove resolved rect/paint correctness — X, Y, Width, Height, the
// solid-fill shorthand, and visibility (VariantVisible, story #283, the
// variant-driven "different child counts" topology change). Widening to
// the rest of `Prop` is additive future work.
table VariantX { value: float32; }
table VariantY { value: float32; }
table VariantWidth { value: float32; }
table VariantHeight { value: float32; }
// The color is required: an override with no color has no meaning, and
// the verifier rejects it at the load gate (P4) — the same mechanism as
// Stroke's required color.
table VariantFill { color: Color (required); }
// Whether the member shows (true) or hides (false) the target node.
// `false` lowers to Taffy Display::None — the child leaves the laid-out
// set and its siblings reflow — exactly as Node.visible does through
// set_prop (story #283).
table VariantVisible { value: bool; }

// A variant's rotation override (story #770). All three components move
// together: an override that changed the angle while leaving a stale
// anchor behind would rotate the node about the wrong point, so the
// override carries the whole channel rather than one third of it.
table VariantRotation {
  angle: float32;
  anchor_x: float32;
  anchor_y: float32;
}

union VariantPropValue {
  VariantX,
  VariantY,
  VariantWidth,
  VariantHeight,
  VariantFill,
  // Appended at the tail (R7): existing arms keep their discriminants.
  VariantVisible,
  VariantRotation,
}

// One overridden prop on one node, active when the owning member is
// selected. `node` is an index into Document.nodes — the same
// cross-reference convention as Node.parent
// (docs/decisions/dsb-sectioned-container.md). `value` is required: an
// override naming no prop has no meaning, and the verifier rejects it
// at the load gate (P4) — the same mechanism as `VariantFill.color`.
table VariantOverride {
  node: uint32;
  value: VariantPropValue (required);
}

// One selectable state of a VariantSet — Figma's "variant" (a member of
// a component set, docs/technotes/glossary.md). `overrides` is sparse:
// only the props that differ from the document's base Node values need
// an entry.
table VariantMember {
  name: string;
  overrides: [VariantOverride];
}

// One switchable group of node/prop overrides — Figma's "component SET"
// (docs/technotes/glossary.md: "variant closure is per component SET").
// Selection is a flat index into `members`; axis-keyed selection is
// deferred (docs/decisions/variant-set-flat-index.md).
table VariantSet {
  members: [VariantMember];
  // Index into `members` selected when a loaded document first commits,
  // before any set_variant call.
  active_member: uint32 = 0;
}

// v0.7 binding tables (story #167,
// docs/decisions/binding-table-in-the-document.md). A binding is intent
// a designer authors (a Figma Variable bound to a property), so it is a
// document construct; signal *values* stay producer-side always (P1).
// One declared signal: the runtime lookup name and the initial value
// every binding of it seeds from. The name is a Figma variable's
// mode-qualified name for an imported document, or a dashlang
// signal_named declaration; absent for an anonymous producer signal.
table SignalDecl {
  name: string;
  initial: float32;
}

// One scalar prop slot a binding can target — the §23 channel
// vocabulary. The values mirror dashscene-core's Channel wire codes;
// append at the tail, never renumber (R7). A reader that meets an
// unknown value must range-check and refuse it by name (P4), like the
// layout enums above.
enum BindingChannel : uint8 {
  X = 0,
  Y = 1,
  Width = 2,
  Height = 3,
  Gap = 4,
  FillR = 5,
  FillG = 6,
  FillB = 7,
  FillA = 8,
  // Node/group opacity (Prop::Opacity), paint-only (story #44, debt #253).
  Opacity = 9,
  // The node's rotation angle in radians, and the two components of the
  // point it turns about, in the node's own space (story #770,
  // docs/decisions/rotation-is-paint-only-and-anchored-explicitly.md).
  // Paint-only, beside Opacity above.
  //
  // All three bind rather than the angle alone: SVG's
  // `<animateTransform type="rotate">` carries "a cx cy" in its `values`
  // list and animates every one of them, so an angle-only channel set
  // would be incomplete against one of the two routes this vocabulary
  // exists for.
  Rotation = 10,
  RotationAnchorX = 11,
  RotationAnchorY = 12,
}

// The declarative scalar transforms (§23 D8). A transform is data by
// construction — dashlang's Custom closure transform never serializes;
// a compiler refuses it by name instead. Format (numeric-to-text) joins
// the union when text bindings serialize.
table TransformScale { factor: float32; }
table TransformMapRange {
  in_lo: float32;
  in_hi: float32;
  out_lo: float32;
  out_hi: float32;
}
table TransformClamp { lo: float32; hi: float32; }

union BindingTransform {
  TransformScale,
  TransformMapRange,
  TransformClamp,
}

// One binding row: signal -> (node, channel) through a transform.
// Explicit and flat — a binding never relates two nodes
// (docs/decisions/bindings-are-explicit-and-flat.md). An absent
// `transform` (union NONE) is the identity transform, so the common
// Figma-authored row costs no transform table at all.
table Binding {
  // Index into Document.signals.
  signal: uint32;
  // Index into Document.nodes — the same cross-reference convention as
  // Node.parent.
  node: uint32;
  channel: BindingChannel;
  transform: BindingTransform;
}

// Story B1 — baked vector shapes
// (docs/wip/2026-07-19-B1-vector-msdf-design.md). A Figma VECTOR node lowers
// into a baked multi-channel signed distance field carried as a coverage mask
// on its paint entry: the document keeps the field as resolution-independent
// intent (like the glyph atlas), never a rasterized result (P1). The painter
// samples median-of-3 to a coverage value and masks the ordinary fill by it,
// so a gradient-filled vector composes day one (P2 composition holds).

// A packed MSDF atlas sheet: one PNG asset holding one or more
// baked vector-shape fields. px_per_em is the field resolution (atlas texels
// per shape em, the em being the shape's longer bounding-box side);
// distance_range is the MSDF spread in atlas texels (msdfgen -pxrange). The
// painter's screen-pixel range is distance_range * screen_px_per_em /
// px_per_em — the glyph-atlas metric
// (crates/dashscene-typeset/src/atlas/metrics.rs).
table VectorAtlas {
  image: uint32;            // index into Document.assets (the atlas PNG)
  px_per_em: float32;
  distance_range: float32;
}

// The sub-rect of one baked shape inside its atlas, in atlas texels.
struct AtlasRect { x: uint32; y: uint32; width: uint32; height: uint32; }

// Where the field quad sits in the shape's own coordinate space (Figma's
// fillGeometry space, y-down). The field extends distance_range/px_per_em
// beyond the geometry edge, so these bounds are the padded quad, not the tight
// geometry box (msdfgen's planeBounds vs. the em box).
struct PlaneBounds { left: float32; top: float32; right: float32; bottom: float32; }

// One baked shape: which atlas, which sub-rect, and how the field quad maps
// into the shape's coordinate space.
table VectorShape {
  atlas: uint32;           // index into Document.vector_atlases
  atlas_rect: AtlasRect;
  plane_bounds: PlaneBounds;
}

table Document {
  // Flattened DFS node tree: array order is DFS order, so array index
  // doubles as rect-table index (docs/design/dashbuf.md).
  nodes: [Node];
  // Retired at v0.11 (story #107) in favour of `assets` below: the document
  // carries asset identity and metadata, never asset bytes
  // (docs/decisions/asset-model-content-addressed-blobs.md). Deprecated
  // rather than deleted, because deleting a field shifts the vtable slot of
  // every field after it and breaks every `.dsb` already written — R7's whole
  // subject. The slot stays reserved and unreadable; documents written before
  // v0.11 still carry bytes here, and nothing reads them.
  images: [Image] (deprecated);
  // The paint pool referenced by Node.paint_entry.
  paints: [Paint];
  // Interned string pool (docs/design/dashbuf.md) referenced by Node.text. Dedup is
  // the producer's job; the pool makes it representable.
  strings: [string];
  // The text style pool referenced by Node.text_style.
  text_styles: [TextStyle];
  // The variant sets a set_variant call selects among (v0.4, story #20).
  variant_sets: [VariantSet];
  // The signal declarations referenced by Binding.signal (v0.7, story #167).
  signals: [SignalDecl];
  // The binding rows joining signals to node channels (v0.7, story #167).
  bindings: [Binding];
  // Story B1: the packed MSDF atlases referenced by VectorShape.atlas, and
  // the baked shapes referenced by Paint.shape_field. Appended at the tail so
  // every pre-B1 document decodes unchanged (R7).
  vector_atlases: [VectorAtlas];
  vector_shapes: [VectorShape];
  // Story #107: the content-addressed asset table, replacing the retired
  // inline `images` pool above. Referenced by `ImageFill.image` and
  // `VectorAtlas.image`. Appended at the tail, so every pre-v0.11 document
  // decodes unchanged (R7).
  assets: [AssetEntry];
}

root_type Document;
