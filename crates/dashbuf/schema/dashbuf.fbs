// The .dsb document schema (DESIGN_1.md §5, §11 v0.1 + v0.3 paint).
//
// Scope: a flattened node tree (doc index = rect-table index, DESIGN
// §5), one layout mode (fixed-size, no Taffy yet), and the v0.3 paint
// vocabulary (DESIGN §11 v0.3, drawn from the §10.1 NOW list): solid
// fills, the four gradient kinds, image fills with scale modes, stroke
// with align, rounded corners, axis-aligned + rounded clip. Paint sits
// in a document-level dedup pool (DESIGN §5) that nodes reference by
// index — the same index model as the runtime paint table. Additional
// layout modes land when v0.2 adds them — FlatBuffers' append-only
// field ids make every extension additive, not a rewrite (R7).

namespace dashbuf;

struct FixedSizeLayout {
  // Authored offset relative to the parent node (or the canvas origin
  // for a root). Intent, not a resolved result (P1) — the resolved
  // absolute position exists only in the runtime rect table.
  x: float32;
  y: float32;
  width: float32;
  height: float32;
}

struct Color {
  r: float32;
  g: float32;
  b: float32;
  a: float32;
}

table SolidFill {
  color: Color;
}

struct Vec2 {
  x: float32;
  y: float32;
}

// One gradient color stop; offset is normalized 0..1 along the
// gradient's primary axis.
struct GradientStop {
  offset: float32;
  color: Color;
}

// Per-corner radii in document units; all zero = sharp corners.
struct CornerRadii {
  top_left: float32;
  top_right: float32;
  bottom_right: float32;
  bottom_left: float32;
}

enum GradientKind : uint8 {
  Linear = 0,
  Radial,
  Angular,
  Diamond,
}

// Stroke placement relative to the node's outline. Painters that only
// stroke on center lower Inside/Outside by path expansion
// (DESIGN §8.1).
enum StrokeAlign : uint8 {
  Inside = 0,
  Center,
  Outside,
}

// Figma image-fill scale modes.
enum ScaleMode : uint8 {
  Fill = 0,
  Fit,
  Crop,
  Tile,
}

enum ImageFormat : uint8 {
  Png = 0,
}

// One geometry model serves all four gradient kinds: three normalized
// handle positions in the node's box — the gradient origin, the
// primary-axis end, and the secondary-axis end (Figma's
// gradientHandlePositions). Handles are intent; resolved geometry is
// per-painter math (P1). Handles and stops are required so the
// flatbuffer verifier itself rejects a geometry-less gradient at the
// load gate (P4) instead of a painter inventing defaults.
table Gradient {
  kind: GradientKind;
  handle_origin: Vec2 (required);
  handle_primary: Vec2 (required);
  handle_secondary: Vec2 (required);
  stops: [GradientStop] (required);
}

table ImageFill {
  // Index into Document.images.
  image: uint32;
  scale_mode: ScaleMode;
}

union Fill {
  SolidFill,
  Gradient,
  ImageFill,
}

// v0.3 strokes are solid-only (see
// docs/decisions/paint-entry-composition.md); the color widens to a
// fill additively if a real file ever needs gradient strokes (R6
// diagnoses them until then). The color is required: a stroke without
// one has no meaning, and requiring it keeps the shape identical to
// dashpaint's mirror (where the color is not optional).
table Stroke {
  width: float32;
  align: StrokeAlign;
  color: Color (required);
}

// Embedded encoded image bytes — the simplest storage form; KTX2/Basis
// packaging is v1 scope (DESIGN §9).
table Image {
  format: ImageFormat;
  bytes: [ubyte];
}

// One entry of the document's paint pool (DESIGN §5's "dedup style
// pool"): what a node is filled with, how its outline is stroked, how
// its corners round, and whether it clips its children to the (rounded)
// box. Nodes reference entries by index; distinct nodes sharing a style
// share one entry.
table Paint {
  fill: Fill;
  stroke: Stroke;
  corners: CornerRadii;
  clip: bool = false;
}

// One entry of the document's text style pool (DESIGN §5's "dedup
// style pool" applied to text): how a text node renders. Never glyph
// data (P1) — family/size/weight/color are intent; shaping and
// placement happen in the runtime (DESIGN §7.2).
table TextStyle {
  // Font family name. Required: a family-less style has no meaning,
  // and the verifier rejects it at the load gate (P4) — the same
  // mechanism as Gradient's required fields.
  family: string (required);
  // Em size in document units.
  size_px: float32;
  // CSS-scale weight, 100..900.
  weight: ushort = 400;
  color: Color;
}

table Node {
  name: string;
  // Index into Document.nodes of this node's parent, or NO_PARENT
  // (uint32::MAX) for a root node.
  parent: uint32 = 4294967295;
  layout: FixedSizeLayout;
  // v0.1 walking-skeleton solid shorthand. Superseded by `paint_entry`
  // when that field is set; kept (append-only ids, R7) until the v0.1
  // producers stop writing it, then removed in a coordinated cleanup.
  paint: SolidFill;
  // Index into Document.paints, or NO_PAINT (uint32::MAX — the same
  // sentinel convention as `parent`) for a node that draws nothing.
  // Document-level only: the committed runtime output has no sentinel —
  // every rect resolves to a pool entry
  // (docs/decisions/boundary-b-unification.md).
  paint_entry: uint32 = 4294967295;
  // Index into Document.strings, or uint32::MAX (the same sentinel
  // convention as `parent`/`paint_entry`) for a node without text
  // content.
  text: uint32 = 4294967295;
  // Index into Document.text_styles, or uint32::MAX for unstyled text
  // (a diagnostic once text validation exists; never a silent
  // default).
  text_style: uint32 = 4294967295;
}

table Document {
  // Flattened DFS node tree: array order is DFS order, so array index
  // doubles as rect-table index (DESIGN §5).
  nodes: [Node];
  // Image assets referenced by ImageFill.image.
  images: [Image];
  // The paint pool referenced by Node.paint_entry.
  paints: [Paint];
  // Interned string pool (DESIGN §5) referenced by Node.text. Dedup is
  // the producer's job; the pool makes it representable.
  strings: [string];
  // The text style pool referenced by Node.text_style.
  text_styles: [TextStyle];
}

root_type Document;
